    "data": {
        "generateAliases": {
            "schema": 4,
            "class": "Drupal\\pathauto\\Commands\\PathautoCommands",
            "method_name": "generateAliases",
            "mtime": 1657960895,
            "injected_classes": [],
            "name": "pathauto:aliases-generate",
            "description": "(Re)generate URL aliases.",
            "help": "",
            "aliases": [
                "pag"
            ],
            "annotations": {
                "command": "pathauto:aliases-generate",
                "throws": "\\Exception"
            },
            "example_usages": {
                "drush pathauto:aliases-generate all all": "Generate all URL aliases.",
                "drush pathauto:aliases-generate create canonical_entities:node": "Generate URL aliases for un-aliased node paths only.",
                "drush pathauto:aliases-generate": "When the arguments are omitted they can be chosen from an interactive menu."
            },
            "return_type": null,
            "arguments": {
                "action": {
                    "description": "The action to take. Possible actions are \"create\" (generate aliases for un-aliased paths only), \"update\" (update aliases for paths that have an existing alias) or \"all\" (generate aliases for all paths).",
                    "default": null
                },
                "types": {
                    "description": "Comma-separated list of aliase typess to generate. Pass \"all\" to generate aliases for all types.",
                    "default": null
                }
            },
            "options": []
        },
        "deleteAliases": {
            "schema": 4,
            "class": "Drupal\\pathauto\\Commands\\PathautoCommands",
            "method_name": "deleteAliases",
            "mtime": 1657960895,
            "injected_classes": [],
            "name": "pathauto:aliases-delete",
            "description": "Delete URL aliases",
            "help": "",
            "aliases": [
                "pad"
            ],
            "annotations": {
                "command": "pathauto:aliases-delete",
                "throws": "\\Exception"
            },
            "example_usages": {
                "drush pathauto:aliases-delete canonical_entities:node": "Delete all automatically generated URL aliases for node entities, preserving manually created aliases.",
                "drush pathauto:aliases-delete all": "Delete all automatically generated URL aliases, preserving manually created ones.",
                "drush pathauto:aliases-delete all --purge": "Delete all URL aliases, including manually created ones.",
                "drush pathauto:aliases-delete": "When the alias types are omitted they can be chosen from an interactive menu."
            },
            "return_type": null,
            "arguments": {
                "types": {
                    "description": "Comma-separated list of alias types to delete. Pass \"all\" to delete aliases for all types.",
                    "default": null
                }
            },
            "options": {
                "purge": {
                    "description": "Deletes all URL aliases, including manually created ones.",
                    "default": false
                }
            }
        },
