        "drush_webform_export": {
            "schema": 4,
            "class": "Drupal\\webform\\Commands\\WebformCommands",
            "method_name": "drush_webform_export",
            "mtime": 1644873819,
            "injected_classes": [],
            "name": "webform:export",
            "description": "Exports webform submissions to a file.",
            "help": "",
            "aliases": [
                "wfx",
                "webform-export"
            ],
            "annotations": {
                "command": "webform:export"
            },
            "example_usages": [],
            "return_type": null,
            "arguments": {
                "webform": {
                    "description": "The webform ID you want to export (required unless --entity-type and --entity-id are specified)",
                    "default": null
                }
            },
            "options": {
                "exporter": {
                    "description": "The type of export. (delimited, table, yaml, or json)"
                },
                "delimiter": {
                    "description": "Delimiter between columns (defaults to site-wide setting). This option may need to be wrapped in quotes. i.e. --delimiter=\"\\t\"."
                },
                "multiple-delimiter": {
                    "description": "Delimiter between an element with multiple values (defaults to site-wide setting)."
                },
                "file-name": {
                    "description": "File name used to export submission and uploaded filed. You may use tokens."
                },
                "archive-type": {
                    "description": "Archive file type for submission file uploadeds and generated records. (tar or zip)"
                },
                "header-format": {
                    "description": "Set to \"label\" (default) or \"key\""
                },
                "options-item-format": {
                    "description": "Set to \"label\" (default) or \"key\". Set to \"key\" to print select list values by their keys instead of labels."
                },
                "options-single-format": {
                    "description": "Set to \"separate\" (default) or \"compact\" to determine how single select list values are exported."
                },
                "options-multiple-format": {
                    "description": "Set to \"separate\" (default) or \"compact\" to determine how multiple select list values are exported."
                },
                "entity-reference-items": {
                    "description": "Comma-separated list of entity reference items (id, title, and\/or url) to be exported."
                },
                "excluded-columns": {
                    "description": "Comma-separated list of component IDs or webform keys to exclude."
                },
                "uuid": {
                    "description": "Use UUIDs for all entity references. (Only applies to CSV download)"
                },
                "entity-type": {
                    "description": "The entity type to which this submission was submitted from."
                },
                "entity-id": {
                    "description": "The ID of the entity of which this webform submission was submitted from."
                },
                "range-type": {
                    "description": "Range of submissions to export: \"all\", \"latest\", \"serial\", \"sid\", or \"date\"."
                },
                "range-latest": {
                    "description": "Integer specifying the latest X submissions will be downloaded. Used if \"range-type\" is \"latest\" or no other range options are provided."
                },
                "range-start": {
                    "description": "The submission ID or start date at which to start exporting."
                },
                "range-end": {
                    "description": "The submission ID or end date at which to end exporting."
                },
                "uid": {
                    "description": "The ID of the user who submitted the form."
                },
                "order": {
                    "description": "The submission order \"asc\" (default) or \"desc\"."
                },
                "state": {
                    "description": "Submission state to be included: \"completed\", \"draft\" or \"all\" (default)."
                },
                "sticky": {
                    "description": "Flagged\/starred submission status."
                },
                "files": {
                    "description": "Download files: \"1\" or \"0\" (default). If set to 1, the exported CSV file and any submission file uploads will be download in a gzipped tar file."
                },
                "destination": {
                    "description": "The full path and filename in which the CSV or archive should be stored. If omitted the CSV file or archive will be outputted to the command line."
                }
            }
        },
