            "method_name": "drush_webform_purge",
            "mtime": 1644873819,
            "injected_classes": [],
            "name": "webform:purge",
            "description": "Purge webform submissions from the databases",
            "help": "",
            "aliases": [
                "wfp",
                "webform-purge"
            ],
            "annotations": {
                "command": "webform:purge"
            },
            "example_usages": {
                "drush webform:purge": "Pick a webform and then purge its submissions.",
                "drush webform:purge contact": "Delete 'Contact' webform submissions.",
                "drush webform:purge ::all": "Purge all webform submissions."
            },
            "return_type": null,
            "arguments": {
                "webform_id": {
                    "description": "A webform machine name. If not provided, user may choose from a list of names.",
                    "default": null
                }
            },
            "options": {
                "all": {
                    "description": "Flush all submissions",
                    "default": false
                },
                "entity-type": {
                    "description": "The entity type for webform submissions to be purged"
                },
                "entity-id": {
                    "description": "The ID of the entity for webform submissions to be purged"
                }
            }
        },
