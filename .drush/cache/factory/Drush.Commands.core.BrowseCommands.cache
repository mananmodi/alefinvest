    "cid": "Drush\\Commands\\core\\BrowseCommands",
    "data": {
        "browse": {
            "schema": 4,
            "class": "Drush\\Commands\\core\\BrowseCommands",
            "method_name": "browse",
            "mtime": 1633432454,
            "injected_classes": [],
            "name": "browse",
            "description": "Display a link to a given path or open link in a browser.",
            "help": "",
            "aliases": [],
            "annotations": {
                "command": "browse",
                "handle-remote-commands": "true"
            },
            "example_usages": {
                "drush browse": "Open default web browser (if configured or detected) to the site front page.",
                "drush browse node\/1": "Open web browser to the path node\/1.",
                "drush @example.prod browse": "Open a browser to the web site specified in a site alias."
            },
            "return_type": null,
            "arguments": {
                "path": {
                    "description": "Path to open. If omitted, the site front page will be opened.",
                    "default": ""
                }
            },
            "options": {
                "browser": {
                    "description": "Open the URL in the default browser. Use --no-browser to avoid opening a browser.",
                    "default": true
                },
                "redirect-port": {
                    "description": "The port that the web server is redirected to (e.g. when running within a Vagrant environment).",
                    "default": 2
                }
            }
        },
