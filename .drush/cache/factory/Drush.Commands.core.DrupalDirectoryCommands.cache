{
    "cid": "Drush\\Commands\\core\\DrupalDirectoryCommands",
    "data": {
        "drupalDirectory": {
            "schema": 4,
            "class": "Drush\\Commands\\core\\DrupalDirectoryCommands",
            "method_name": "drupalDirectory",
            "mtime": 1633432454,
            "injected_classes": [],
            "name": "drupal:directory",
            "description": "Return the filesystem path for modules\/themes and other key folders.",
            "help": "",
            "aliases": [
                "dd",
                "drupal-directory"
            ],
            "annotations": {
                "command": "drupal:directory"
            },
            "example_usages": {
                "cd $(drush dd devel)": "Navigate into the devel module directory",
                "cd $(drush dd)": "Navigate to the root of your Drupal site",
                "cd $(drush dd files)": "Navigate to the files directory.",
                "drush dd @alias:%files": "Print the path to the files directory on the site @alias.",
                "edit $(drush dd devel)\/devel.module": "Open devel module in your editor"
            },
            "return_type": null,
            "arguments": {
                "target": {
                    "description": "A module\/theme name, or special names like root, files, private, or an \u003cinfo\u003ealias:path\u003c\/info\u003e string such as @alias:%files.",
                    "default": "root"
                }
            },
            "options": {
                "local-only": {
                    "description": "Reject any target that specifies a remote site.",
                    "default": false
                }
            }
        },
