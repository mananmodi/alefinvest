    "data": {
        "docs": {
            "schema": 4,
            "class": "Drush\\Commands\\core\\MkCommands",
            "method_name": "docs",
            "mtime": 1633432454,
            "injected_classes": [],
            "name": "mk:docs",
            "description": "Build a Markdown document for each Drush command thats available on a site.",
            "help": "This command is an early step when building the www.drush.org static site. Adapt it to build a similar site listing the commands that are available on your site. Also see Drush's [Github Actions workflow](https:\/\/github.com\/drush-ops\/drush\/blob\/10.x\/.github\/workflows\/main.yml).",
            "aliases": [],
            "annotations": {
                "command": "mk:docs",
                "bootstrap": "max"
            },
            "example_usages": {
                "drush mk:docs --destination=commands": "Build many .md files in the docs\/commands directory."
            },
            "return_type": null,
            "arguments": [],
            "options": {
                "destination": {
                    "description": "The path, relative to 'docs' dir, where command docs should be written.",
                    "default": 2
                }
            }
        },
