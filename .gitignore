# Processed by git_backup
# Ignore directories generated by Composer
/vendor/
/core/
# Ignore SimpleTest multi-site environment.
/sites/simpletest
# Ignore caches
/sites/*/files/styles/
/sites/*/files/php/
/sites/*/files/css/
/sites/*/files/js/
/sites/*/files/translations/
/.csslintrc
/.editorconfig
/.eslintignore
/.eslintrc.json
/.ht.router.php
/.htaccess
/INSTALL.txt
/README.txt
/example.gitignore
/robots.txt