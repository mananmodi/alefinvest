{
    "name": "alternativecommerce/drupal-project",
    "description": "Project template for Drupal 8 projects with composer",
    "type": "project",
    "license": "NoLicense",
    "repositories": [
        {
            "type": "composer",
            "url": "https://packages.drupal.org/8"
        }
    ],
    "require": {
        "composer/installers": "^1.9",
        "cweagans/composer-patches": "^1.7",
        "drupal/account_field_split": "^2.0",
        "drupal/admin_toolbar": "^3.4",
        "drupal/ajax_comments": "^1.0",
        "drupal/basket": "^2.0",
        "drupal/basket_imex": "^10.0",
        "drupal/captcha": "^1.2",
        "drupal/ckeditor_entity_link": "^1.0@dev",
        "drupal/ckeditor_font": "^1.0",
        "drupal/ckeditor_templates": "^1.1",
        "drupal/ckeditor_youtube": "^1.2",
        "drupal/classy": "^1.0",
        "drupal/clean_files_entity": "^1.2",
        "drupal/color_field": "^3.0",
        "drupal/colorbutton": "^1.1",
        "drupal/comments_order": "^3.0",
        "drupal/core-composer-scaffold": "^10",
        "drupal/core-project-message": "^10",
        "drupal/core-recommended": "^10.3",
        "drupal/disable_language": "^1.0",
        "drupal/double_field": "^4.0",
        "drupal/editor_advanced_link": "^2.2",
        "drupal/email_registration": "^1.0",
        "drupal/externalauth": "^2.0",
        "drupal/field_group": "^3.0",
        "drupal/filefield_sources": "^2.0@dev",
        "drupal/geolocation": "^3.0",
        "drupal/gin": "^3.0@RC",
        "drupal/gin_toolbar": "^1.0@beta",
        "drupal/google_analytics": "^4.0",
        "drupal/gtext": "^9.0",
        "drupal/handy_cache_tags": "^1.0",
        "drupal/imagecache_external": "^3.0",
        "drupal/imce": "^3.1",
        "drupal/jquery_ui_slider": "^2.1",
        "drupal/linkit": "^6.1",
        "drupal/liqpay": "^1.0",
        "drupal/magnific_popup": "^2.0",
        "drupal/menu_trail_by_path": "^2.0",
        "drupal/metatag": "^2.0",
        "drupal/minifyhtml": "^2.0",
        "drupal/nbsp": "^2.0@alpha",
        "drupal/novaposhta": "^1.0",
        "drupal/paragraphs": "^1.8",
        "drupal/paragraphs_edit": "^2.0@alpha",
        "drupal/pathauto": "^1.6@beta",
        "drupal/quick_node_clone": "^1.12",
        "drupal/redirect": "^1.2",
        "drupal/schema_metatag": "^3.0",
        "drupal/scss_compiler": "^1.0@RC",
        "drupal/seven": "^1.0",
        "drupal/simple_pass_reset": "^1.1",
        "drupal/simple_sitemap": "^4.1",
        "drupal/single_datetime": "^2.0@beta",
        "drupal/smtp": "^1.0",
        "drupal/social_api": "^3.0",
        "drupal/social_auth": "^3.0",
        "drupal/social_auth_facebook": "^3.0",
        "drupal/social_auth_google": "^3.0@RC",
        "drupal/svg_image": "^3.0",
        "drupal/token": "^1.3",
        "drupal/transliterate_filenames": "^2.0",
        "drupal/tvi": "^2.0@alpha",
        "drupal/views_ajax_history": "^1.6",
        "drupal/views_fieldsets": "^4.0",
        "drupal/webform": "^6.2",
        "drupal/webp": "^1.0@beta",
        "drupal/yoast_seo": "^2.0@alpha",
        "drupal/youtube": "^2.0",
        "drush/drush": "^12",
        "mnsami/composer-custom-directory-installer": "^2.0",
        "oomphinc/composer-installers-extender": "^2.0",
        "webflo/drupal-finder": "^1.0.0",
        "wikimedia/composer-merge-plugin": "^2.1"
    },
    "conflict": {
        "drupal/drupal": "*"
    },
    "minimum-stability": "dev",
    "prefer-stable": true,
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "composer/installers": true,
            "drupal/console-extend-plugin": true,
            "zodiacmedia/drupal-libraries-installer": true,
            "cweagans/composer-patches": true,
            "drupal/core-composer-scaffold": true,
            "drupal/core-project-message": true,
            "mnsami/composer-custom-directory-installer": true,
            "oomphinc/composer-installers-extender": true,
            "php-http/discovery": true,
            "phpstan/extension-installer": true,
            "dealerdirect/phpcodesniffer-composer-installer": true,
            "wikimedia/composer-merge-plugin": true,
            "tbachert/spi": true
        }
    },
    "autoload": {
        "classmap": [
            "scripts/composer/ScriptHandler.php"
        ]
    },
    "scripts": {
        "drupal-scaffold": "DrupalComposer\\DrupalScaffold\\Plugin::scaffold",
        "pre-install-cmd": [
            "DrupalProject\\composer\\ScriptHandler::checkComposerVersion"
        ],
        "pre-update-cmd": [
            "DrupalProject\\composer\\ScriptHandler::checkComposerVersion"
        ],
        "post-install-cmd": [
            "DrupalProject\\composer\\ScriptHandler::createRequiredFiles"
        ],
        "post-update-cmd": [
            "DrupalProject\\composer\\ScriptHandler::createRequiredFiles"
        ]
    },
    "extra": {
        "installer-types": ["drupal-glyanec-module","drupal-basket-module", "drupal-basket-v2-module"],
        "installer-paths": {
            "core": ["type:drupal-core"],
            "libraries/{$name}": ["type:drupal-library", "scssphp/scssphp"],
            "modules/basket/{$name}": ["type:drupal-basket-v2-module", "drupal/basket", "drupal/liqpay", "drupal/basket_imex"],
            "modules/contrib/{$name}": ["type:drupal-module"],
            "profiles/contrib/{$name}": ["type:drupal-profile"],
            "themes/contrib/{$name}": ["type:drupal-theme"],
            "drush/contrib/{$name}": ["type:drupal-drush"]
        },
        "merge-plugin": {
            "include": [
                "modules/basket/basket/composer.libraries.json"
            ]
        },
        "patches": {}
    },
    "require-dev": {
        "drupal/core-dev": "^10"
    }
}
