function other_user_format_name_alter(&$name, $account) {
	$user = User::load($account->id());
	$u_name = [];
  if(!empty($user->field_user_surname[0]->value)){
    $u_name[] = $user->get('field_user_surname')->getValue()[0]['value'];
  }
	if(!empty($user->field_user_name[0]->value)){
		$u_name[] = $user->get('field_user_name')->getValue()[0]['value'];
	}
	if(!empty($u_name)){
		$name = implode(' ', $u_name);
	}
}

