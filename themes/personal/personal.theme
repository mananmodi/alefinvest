<?php
	
use Drupal\block\Entity\Block;
use Drupal\Component\Utility\Unicode;
use Drupal\Core\Render\Markup;
use Drupal\Core\Url;
use Drupal\Core\Link;

function personal_preprocess_image(&$vars) {
  $vars['attributes']['data-width'] = $vars['width'];
  $vars['attributes']['data-height'] = $vars['height'];
  if (pathinfo($vars['uri'], PATHINFO_EXTENSION) === 'svg') {
    if (empty($vars['attributes']['width'])) {
      $vars['attributes']['width'] = $vars['width'];
    } else if ($vars['attributes']['width'] > $vars['width']) {
      $vars['attributes']['width'] = $vars['width'];
    }
    if (empty($vars['attributes']['height'])) {
      $vars['attributes']['height'] = $vars['height'];
    } else if ($vars['attributes']['height'] > $vars['height']) {
      $vars['attributes']['height'] = $vars['height'];
    }
    if (empty($vars['attributes']['alt'])) $vars['attributes']['alt'] = '';
  }
}

function personal_preprocess_youtube_thumbnail(&$vars) {
  if (isset($vars['image']) && $vars['image'] instanceof Link) {
    $text = $vars['image']->getText();
    $text['#attributes']['lazy_enabled'] = TRUE;
    $vars['image']->setText($text);
  }
}

function personal_preprocess_region__header_top(&$vars) {
  $content = $vars['content'];
  $vars['content'] = [
    'mobile_btn_wrapper' => [
      '#type' => 'container',
      '#attributes' => [
        'class'       => ['mobile-btn-wrapper']
      ],
      'mobile_button' => [
        '#markup' => '<div class="js-main-menu mobile-btn--menu"><span></span></div>'
      ],
    ],
    'content' => [
      '#type' => 'markup',
      '#markup' => $content,
    ]
  ];
}

function personal_preprocess_block(&$vars) {
  if (!empty($vars['elements']['content']['#block_content'])) {
    $bundle = $vars['elements']['content']['#block_content']->bundle();
    $vars['attributes']['class'][] = 'block-type-' . str_replace('_', '-', $bundle);
  }
  if (isset($vars['elements']['content']['#type']) && $vars['elements']['content']['#type'] === 'view') {
    $vars['attributes']['class'][] = 'view-block-' . $vars['elements']['content']['#name'];
  }

  $id = $vars['elements']['#id'];
  if($id === 'user_login') {
      if(\Drupal::currentUser()->isAnonymous()) {
          $vars['attributes']['class'][] ='block-user-login--anonymous';
      }  else {
          $vars['attributes']['class'][] ='block-user-login--authorized';
      }
  }

//  if($id === 'exposed_form_catalog_page_4') {
//    $vars['content']['button'] = [
//      '#markup' => '<div class="search-btn js-search-btn">'. t('Search') .'</div>'
//    ];
//  }

}

