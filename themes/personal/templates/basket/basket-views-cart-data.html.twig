{{ attach_library('basket_other/basket_other.js') }}
{{ attach_library('basket_other/tooltipster') }}
{% if info.view.id == 'cart_goods' and info.view.current_display == 'block_1' %}
	{%
		set totalSumNotDiscountDelivery = info.Cart.getTotalSum(TRUE, TRUE)
	%}
	{%
		set totalSumNotDiscount = info.Cart.getTotalSum(FALSE, FALSE)
	%}

	<div class="line">
		<a class="edit_link" href="javascript:void(0);" onclick="basket_ajax_link(this, '{{ url('basket.pages', {'page_type': 'api-load_popup'}) }}')" data-post="{{ {'load_popup': 'basket_view_edit'}|json_encode }}">{{ 'Edit order'|t }}</a>
	</div>
	<table>
		<tr>
			<td class="label">
				{{ 'Order price:'|t }}
			</td>
			<td class="value">
				{{ totalSumNotDiscountDelivery|number_format(2, ',', ' ') }} {{ basket_t(info.Cart.getCurrencyName()) }}
			</td>
		</tr>
		{% if info.delivery.sum %}
			<tr>
				<td class="label">
					{{ 'Cost of delivery:'|t }}
				</td>
				<td class="value">
					{{ info.delivery.sum|number_format(2, ',', ' ') }}
					{% if info.delivery.currency %}
						{{ basket_t(info.delivery.currency) }}
					{% else %}
						{{ basket_t(info.Cart.getCurrencyName()) }}
					{% endif %}
					{% if info.delivery.description %}
						<span class="tooltip" data-voc="delivery">i</span>
						<div class="desc_delivery" style="display:none;">{{ info.delivery.description }}</div>
					{% endif %}
				</td>
			</tr>
		{% endif %}
		{% if totalSumNotDiscount < totalSumNotDiscountDelivery %}
			<tr>
				<td class="label">
					{{ 'A discount:'|t }}
				</td>
				<td class="value">
					{{ (totalSumNotDiscountDelivery-totalSumNotDiscount)|number_format(2, ',', ' ') }} {{ basket_t(info.Cart.getCurrencyName()) }}
				</td>
			</tr>
		{% endif %}
		<tr>
			<td class="label">
				{{ 'To pay:'|t }}
			</td>
			<td class="value">
				<span class="total">{{ info.Cart.getTotalSum()|number_format(2, ',', ' ') }} {{ basket_t(info.Cart.getCurrencyName()) }}</span>
			</td>
		</tr>
	</table>
{% elseif info.view.id == 'cart_goods' and info.view.current_display == 'block_2' %}
	<div class="bot_line">
		<div class="sum_pay">
			<b>{{ 'Order price:'|t }}</b> {{ info.Cart.getTotalSum(TRUE, TRUE)|number_format(2, ',', ' ') }} {{ basket_t(info.Cart.getCurrencyName()) }}
		</div>
		<div class="buttons">
{#			<a class="button button-order" href="javascript:void(0);" onclick="jQuery('.mfp-close').click();">{{ basket_t('Checkout') }}</a>#}
			<a class="button button-order" href="javascript:void(0);" onclick="jQuery('.ui-dialog-titlebar-close').click();">{{ basket_t('Checkout') }}</a>
		</div>
	</div>
{% else %}
	{% if info.Cart.getCount %}
		<div class="bot_line">
			<div class="sum_pay">
				<b>{{ 'Order price:'|t }}</b> <span>{{ info.Cart.getTotalSum(FALSE, TRUE)|number_format(2, ',', ' ') }} {{ basket_t(info.Cart.getCurrencyName()) }}</span>
			</div>
			<div class="buttons">
{#				<a class="button button-back" href="javascript:history.back();">{{ basket_t('Continue shopping') }}</a>#}
				<a class="button button-back" href="{{ url('view.catalog.page_1', {'arg_0': 'all'}) }}">{{ basket_t('Continue shopping') }}</a>
				<a class="button button-order" href="{{ url('basket.pages', {'page_type': 'order'}) }}">{{ basket_t('Checkout') }}</a>
			</div>
		</div>
	{% endif %}
{% endif %}